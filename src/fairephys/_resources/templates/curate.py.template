"""$dataset_name curation pipeline.

Steps: compile -> build-probes -> bids-layout -> convert -> sanity -> validate
"""

from pathlib import Path

from fairephys import bids, enrichment, probes
from fairephys.bids import METADATA_DIRNAME, builder
from fairephys.converters import $converter_class, build_nwb_metadata
from fairephys.curation import (
    build_parser, compile_metadata, finalize_compilation, find_session, run_pipeline, run_sanity_checks,
    session_paths,
)

DATASET_DIR = Path(__file__).parent
TEMPLATES_DIR = DATASET_DIR / "metadata" / "curated"
CURATED_DATA_DIR = DATASET_DIR / "curated-data"
METADATA_DIR = CURATED_DATA_DIR / METADATA_DIRNAME
RAW_DATA_DIR = DATASET_DIR / "raw-data"
VALIDATION_DIR = DATASET_DIR / "validation"

DATASET_NAME = "$dataset_name"
RECORDING_FORMAT = "$recording_format"   # a key of fairephys.formats.RAW_FORMATS

# TODO: raw channel names to BIDS channel types: "prefixes", "names", "default"
CHANNEL_TYPES = {"prefixes": {}, "names": {}, "default": "MISC"}


def discover_sessions() -> list[str]:
    """TODO: the session ids from the raw data layout."""
    raise NotImplementedError("Implement session discovery for your raw data layout")


def get_raw_file(session_id: str) -> Path:
    """TODO: the raw recording file (or folder) of a session."""
    raise NotImplementedError("Implement raw file lookup for your data layout")


def sessions(args) -> list[str]:
    """The session given with --session, else every session."""
    return [args.session] if args.session else discover_sessions()


def compile_cmd(enrich_openminds: bool = True, shared_dir: Path = None) -> Path:
    """Step 1: YAML -> odML, enriched from the raw headers (Neo) and openMINDS."""
    _, doc = compile_metadata(TEMPLATES_DIR, shared_dir=shared_dir)
    for session_id in discover_sessions():
        neo_data = enrichment.neo_extract(get_raw_file(session_id), format=RECORDING_FORMAT)
        enrichment.neo_enrich_document(doc, neo_data, session_id)
    return finalize_compilation(doc, METADATA_DIR, DATASET_NAME, enrich_openminds, validation_dir=VALIDATION_DIR)


def probes_cmd(doc, session_id: str, args):
    """Step 2: the session's ProbeInterface group, one probe per Electrode Placement."""
    session = find_session(doc, session_id)
    paths = session_paths(doc, session, CURATED_DATA_DIR)
    probes.write_session_probe_group(doc, session, paths["probe_group"].parent)


def bids_cmd(doc, session_id: str, args):
    """Step 3: the BIDS sidecars of the session and the dataset-level files."""
    session = find_session(doc, session_id)
    paths = session_paths(doc, session, CURATED_DATA_DIR)
    channels = builder.extract_channels(session, paths["probe_group"], channel_types=CHANNEL_TYPES)
    bids.write_session_sidecars(doc, session, paths, channels)
    bids.write_run_sidecars(doc, session, paths)
    bids.write_dataset_files(doc, CURATED_DATA_DIR)


def convert_cmd(doc, session_id: str, args):
    """Step 4: the raw recording to NWB."""
    session = find_session(doc, session_id)
    paths = session_paths(doc, session, CURATED_DATA_DIR)
    raw_path = get_raw_file(session_id)
    converter = $converter_class(
        $converter_args
    )
    converter.run_conversion(paths["nwb"], build_nwb_metadata(doc, session), stub_test=args.stub_test)


def sanity_cmd(doc, session_id: str, args):
    """Step 5: the session's raw, BIDS and NWB files against each other."""
    paths = session_paths(doc, find_session(doc, session_id), CURATED_DATA_DIR)
    run_sanity_checks(get_raw_file(session_id), paths, session_id, VALIDATION_DIR, recording_format=RECORDING_FORMAT)


def main():
    args = build_parser("$dataset_name curation pipeline").parse_args()
    run_pipeline(args, sessions=sessions, compile=compile_cmd,
                 steps={"build_probes": probes_cmd, "bids_layout": bids_cmd, "convert": convert_cmd,
                        "sanity": sanity_cmd},
                 odml_path=METADATA_DIR / f"{DATASET_NAME}.odml.xml",
                 curated_dir=CURATED_DATA_DIR, validation_dir=VALIDATION_DIR)


if __name__ == "__main__":
    main()
